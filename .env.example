# 本地开发凭据说明
# 以下为本地开发固定值，真实环境必须替换；.env 不进入版本库

TZ=Asia/Shanghai

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mall
MYSQL_USER=dev
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=1234

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RocketMQ
ROCKETMQ_NAMESRV_HOST=localhost
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_HOST=host.docker.internal
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_VIP_PORT=10909
ROCKETMQ_BROKER_HA_PORT=10912
ROCKETMQ_DASHBOARD_PORT=18080
ROCKETMQ_TOPIC=mall-topic
ROCKETMQ_PRODUCER_GROUP=mall-producer
ROCKETMQ_CONSUMER_GROUP=mall-consumer

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PRODUCT=mall_product

# RustFS（S3 兼容对象存储）
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=dev
RUSTFS_SECRET_KEY=1234
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET_PRODUCT=mall-product
RUSTFS_PUBLIC_BASE_URL=http://localhost:9000/mall-product
RUSTFS_INIT_BUCKET=true

# OpenAI 兼容 Embedding 接口
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024

# JWT（HS256 要求密钥不短于 32 字节）
JWT_SECRET=local-dev-secret-please-replace-with-32-bytes-min
JWT_EXPIRE_MINUTES=120
