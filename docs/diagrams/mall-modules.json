  "cards": [
    {
      "dot": "cyan",
      "title": "模块边界",
      "items": [
        "每个模块内部按 controller / service / mapper / entity / dto / mq 分层",
        "entity 不跨模块暴露，跨模块只走 DTO 与 service 方法",
        "seckill 与 search 依赖 product，反向无依赖"
      ]
    },
    {
      "dot": "emerald",
      "title": "两条主线",
      "items": [
        "秒杀：Redis Lua 预扣 → RocketMQ 异步落库 → 延迟消息与定时扫描回补",
        "检索：BM25 与 kNN 双路召回 → 应用层 RRF 融合 → 按 ES 文档组装结果"
      ]
    },
    {
      "dot": "amber",
      "title": "外部依赖",
      "items": [
        "Elasticsearch 8 承载索引与向量检索，MySQL 承载全部业务表",
        "Embedding 走 OpenAI 兼容接口，失败降级为纯关键词召回",
        "RustFS 只承担商品图片，不做通用文件服务"
      ]
    }
  ]
}
