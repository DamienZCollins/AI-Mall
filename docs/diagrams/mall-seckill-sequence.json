  "cards": [
    {
      "dot": "emerald",
      "title": "请求路径",
      "items": [
        "一次 Lua 脚本完成时间窗、一人一单、库存判断与扣减",
        "失败码直接返回，负数分支不修改任何键",
        "成功只投递消息，不等建单结果"
      ]
    },
    {
      "dot": "cyan",
      "title": "一致性兜底",
      "items": [
        "消费端以 stock > 0 条件更新再扣一次数据库库存",
        "(user_id, activity_id) 唯一索引兜重复消息",
        "表级 CHECK 约束使负库存无法写入"
      ]
    },
    {
      "dot": "amber",
      "title": "回补闭环",
      "items": [
        "延迟消息负责精确关单，定时扫描按分钟兜底",
        "状态流转用条件更新，重复触发不会重复回补",
        "回补库存但保留买家标记，一人一单终身有效"
      ]
    }
  ]
